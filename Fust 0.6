function Fust.IsValid(char)
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    local state = hum:GetState()
    if state == Enum.HumanoidStateType.Dead or state == Enum.HumanoidStateType.Physics then return false end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root or root.Anchored then return false end
    return true
end

local function isVis(part, char)
    if not Config.Aim_VisibleCheck then return true end
    local rp = RaycastParams.new()
    rp.FilterDescendantsInstances, rp.FilterType = {LP.Character, char}, Enum.RaycastFilterType.Exclude
    return workspace:Raycast(Camera.CFrame.Position, part.Position - Camera.CFrame.Position, rp) == nil
end

function Fust.GetTarget(fov, dist)
    local best, minD = nil, fov
    local ctr = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    local mh = LP.Character and LP.Character:FindFirstChild("Head")
    if not mh then return nil end

    local function chk(ch)
        if not Fust.IsValid(ch) then return end
        local h = ch:FindFirstChild(Config.Aim_Part)
        if h and (h.Position - mh.Position).Magnitude <= dist then
            local sp, on = Camera:WorldToViewportPoint(h.Position)
            if on and sp.Z > 0 then
                local d2 = (Vector2.new(sp.X, sp.Y) - ctr).Magnitude
                if d2 < minD and isVis(h, ch) then minD = d2; best = h end
            end
        end
    end

    for _, plr in ipairs(Players:GetPlayers()) do if plr ~= LP then chk(plr.Character) end end
    if Config.Aim_Bots or Config.BT_Enabled then
        for _, b in ipairs(Fust.BotCache or {}) do chk(b) end
    end
    return best
end

task.spawn(function()
    while task.wait(1.5) do
        local newCache = {}
        if Config.ESP_Bots or Config.Aim_Bots or Config.BT_Enabled then
            for _, v in ipairs(workspace:GetDescendants()) do
                if v:IsA("Model") and Fust.IsValid(v) and not Players:GetPlayerFromCharacter(v) then
                    table.insert(newCache, v)
                end
            end
        end
        Fust.BotCache = newCache
    end
end)

task.spawn(function()
    while task.wait(1) do
        local pc, bc = 0, 0
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LP and Fust.IsValid(plr.Character) then pc = pc + 1 end
        end
        for _, b in ipairs(Fust.BotCache or {}) do
            if Fust.IsValid(b) then bc = bc + 1 end
        end
        if Fust.CounterText then Fust.CounterText.Text = string.format("Players: %d | Bots: %d", pc, bc) end
    end
end)

workspace.DescendantAdded:Connect(function(inst)
    if not inst:IsA("BasePart") or not Config.BT_Enabled then return end
    local n = inst.Name:lower()
    if n:find("arrow") or n:find("bullet") or n:find("proj") or n:find("bolt") then
        if math.random(1,100) <= Config.BT_Chance then
            local target = Fust.GetTarget(500, Config.BT_Radius)
            if target then
                inst.Gravity = 0
                task.spawn(function()
                    while inst.Parent do
                        task.wait(0.03)
                        local hu = target.Parent and target.Parent:FindFirstChildOfClass("Humanoid")
                        if hu and hu.Health > 0 then
                            local d = (target.Position - inst.Position).Unit
                            inst.AssemblyLinearVelocity = d * 250
                            inst.CFrame = CFrame.lookAt(inst.Position, inst.Position + d)
                        else break end
                    end
                end)
            end
        end
    end
end)

RunService.RenderStepped:Connect(function()
    pcall(function()
        -- Безопасный FOV рук
        if Camera.FieldOfView ~= Config.FOV_Arms then
            Camera.FieldOfView = Config.FOV_Arms
        end
        
        -- Безопасный Night Vision (без зеленого фильтра)
        if Config.NightVision then
            Lighting.Brightness = 2
            Lighting.GlobalShadows = false
            Lighting.Ambient = Color3.fromRGB(130, 130, 130)
            Lighting.OutdoorAmbient = Color3.fromRGB(130, 130, 130)
        end

        if Config.Aim_Enabled and Config.Aim_ShowFOV then
            fovCircle.Visible = true
            fovCircle.Size = UDim2.new(0, Config.Aim_FOV * 2, 0, Config.Aim_FOV * 2)
        else fovCircle.Visible = false end

        if Config.Aim_Enabled and not Config.BT_Enabled then
            local target = Fust.GetTarget(Config.Aim_FOV, 1500)
            if target then
                Camera.CFrame = Camera.CFrame:Lerp(CFrame.lookAt(Camera.CFrame.Position, target.Position), Config.Aim_Smooth / 10)
            end
        end
    end)
end)

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Camera = workspace.CurrentCamera
local LP = Players.LocalPlayer
local Fust = _G.Fust

if not Fust or not Fust.Gui or not Fust.Config then return end
local Config = Fust.Config
local Gui = Fust.Gui

local Icons = {["AK-47"]="rbxassetid://112199877713402", ["M4A1"]="rbxassetid://112199886750135", Default="rbxassetid://1316045217"}
local espData = {}

-- GUNS ESP (Оружие на земле)
task.spawn(function()
    while task.wait(2) do
        if Config.ESP_GunsGround then
            for _, obj in ipairs(workspace:GetDescendants()) do
                if (obj:IsA("Tool") or (obj:IsA("Model") and obj.Name:lower():find("gun"))) and not obj:GetAttribute("FustGunESP") then
                    if not obj:IsDescendantOf(LP.Character) then
                        obj:SetAttribute("FustGunESP", true)
                        local hl = Instance.new("Highlight")
                        hl.FillColor = Color3.fromRGB(255, 150, 0)
                        hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                        hl.FillTransparency = 0.5
                        hl.OutlineTransparency = 0
                        hl.Adornee = obj
                        hl.Parent = obj
                    end
                end
            end
        else
            for _, obj in ipairs(workspace:GetDescendants()) do
                if obj:GetAttribute("FustGunESP") then
                    local hl = obj:FindFirstChildOfClass("Highlight")
                    if hl then hl:Destroy() end
                    obj:SetAttribute("FustGunESP", nil)
                end
            end
        end
    end
end)

local function getWeaponName(char)
    local tool = char:FindFirstChildWhichIsA("Tool")
    if tool then return tool.Name end
    local rightHand = char:FindFirstChild("RightHand") or char:FindFirstChild("Right Arm")
    if rightHand then
        local gunModel = rightHand:FindFirstChildOfClass("Model")
        if gunModel then return gunModel.Name end
    end
    return nil
end

RunService.RenderStepped:Connect(function()
    pcall(function()
        local draw = {}
        if Config.ESP_Enabled then
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= LP and Fust.IsValid(plr.Character) then table.insert(draw, plr.Character) end
            end
            if Config.ESP_Bots then
                for _, b in ipairs(Fust.BotCache or {}) do if Fust.IsValid(b) then table.insert(draw, b) end end
            end
        end

        local myChar = LP.Character
        local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")

        for _, ch in ipairs(draw) do
            local h, r, hu = ch:FindFirstChild("Head"), ch:FindFirstChild("HumanoidRootPart"), ch:FindFirstChildOfClass("Humanoid")
            if h and r and hu and hu.Health > 0 then
                local tp, to = Camera:WorldToViewportPoint(h.Position + Vector3.new(0,0.5,0))
                local bp, bo = Camera:WorldToViewportPoint(r.Position - Vector3.new(0,2.8,0))
                
                if to and bo and tp.Z > 0 then
                    local e = espData[ch]
                    if not e then
                        e = { 
                            b = Instance.new("Frame", Gui), n = Instance.new("TextLabel", Gui), icon = Instance.new("ImageLabel", Gui),
                            hpTxt = Instance.new("TextLabel", Gui), hpBarBg = Instance.new("Frame", Gui), hpBarFill = Instance.new("Frame", Gui)
                        }
                        e.b.BackgroundTransparency = 1; e.b.BorderSizePixel = 0
                        Instance.new("UIStroke", e.b).Color = Color3.fromRGB(255,60,60)
                        
                        e.n.BackgroundTransparency = 1; e.n.TextColor3 = Color3.new(1,1,1)
                        e.n.Font = Enum.Font.GothamBold; e.n.TextSize = 11; e.n.TextStrokeTransparency = 0
                        
                        e.icon.BackgroundTransparency = 1; e.icon.Size = UDim2.new(0, 30, 0, 30)
                        
                        e.hpTxt.BackgroundTransparency = 1; e.hpTxt.TextColor3 = Color3.fromRGB(0,255,0)
                        e.hpTxt.Font = Enum.Font.GothamBold; e.hpTxt.TextSize = 10; e.hpTxt.TextStrokeTransparency = 0
                        
                        e.hpBarBg.BackgroundColor3 = Color3.fromRGB(20,20,20); e.hpBarBg.BorderSizePixel = 0
                        e.hpBarFill.BackgroundColor3 = Color3.fromRGB(0,255,0); e.hpBarFill.BorderSizePixel = 0
                        
                        espData[ch] = e
                    end
                    
                    local hh = math.abs(bp.Y - tp.Y)
                    e.b.Visible = Config.ESP_Boxes
                    e.b.Position = UDim2.new(0, tp.X - (hh*0.3), 0, tp.Y)
                    e.b.Size = UDim2.new(0, hh*0.6, 0, hh)
                    
                    e.n.Visible = Config.ESP_Names
                    e.n.Position = UDim2.new(0, tp.X - 75, 0, tp.Y - 16)
                    e.n.Size = UDim2.new(0, 150, 0, 14)
                    
                    local distStr = ""
                    if myRoot then distStr = " [" .. math.floor((r.Position - myRoot.Position).Magnitude) .. "m]" end
                    
                    local weapon = getWeaponName(ch)
                    if weapon then
                        e.n.Text = Config.ESP_WeaponText and (ch.Name .. " [" .. weapon .. "]" .. distStr) or (ch.Name .. distStr)
                        if Config.ESP_WeaponIcon then
                            e.icon.Visible = true
                            e.icon.Position = UDim2.new(0, tp.X - 15, 0, tp.Y - 50)
                            e.icon.Image = Icons[weapon] or Icons["Default"]
                        else e.icon.Visible = false end
                    else
                        e.n.Text = ch.Name .. distStr
                        e.icon.Visible = false
                    end
                    
                    -- HP (Текст и Полоска)
                    local hpPct = hu.Health / hu.MaxHealth
                    e.hpTxt.Visible = Config.ESP_HP_Text
                    e.hpTxt.Position = UDim2.new(0, tp.X - 15, 1, 2)
                    e.hpTxt.Size = UDim2.new(0, 30, 0, 12)
                    e.hpTxt.Text = tostring(math.floor(hu.Health))
                    
                    e.hpBarBg.Visible = Config.ESP_HP_Bar
                    e.hpBarFill.Visible = Config.ESP_HP_Bar
                    e.hpBarBg.Position = UDim2.new(0, tp.X - (hh*0.3) - 5, 0, tp.Y)
                    e.hpBarBg.Size = UDim2.new(0, 3, 0, hh)
                    e.hpBarFill.Position = UDim2.new(0, 0, 1 - hpPct, 0)
                    e.hpBarFill.Size = UDim2.new(1, 0, hpPct, 0)
                    e.hpBarFill.BackgroundColor3 = Color3.fromRGB(255 * (1-hpPct), 255 * hpPct, 0)
                else
                    if espData[ch] then 
                        espData[ch].b.Visible = false; espData[ch].n.Visible = false; espData[ch].icon.Visible = false
                        espData[ch].hpTxt.Visible = false; espData[ch].hpBarBg.Visible = false
                    end
                end
            else
                if espData[ch] then 
                    espData[ch].b.Visible = false; espData[ch].n.Visible = false; espData[ch].icon.Visible = false
                    espData[ch].hpTxt.Visible = false; espData[ch].hpBarBg.Visible = false
                end
            end
        end

        for ch, e in pairs(espData) do
            if not ch.Parent or not table.find(draw, ch) then
                e.b:Destroy(); e.n:Destroy(); e.icon:Destroy(); e.hpTxt:Destroy(); e.hpBarBg:Destroy()
                espData[ch] = nil
            end
        end
    end)
end)
