local Pages, TabBtns = {}, {}
local function SwitchTab(idx)
    for i, btn in ipairs(TabBtns) do
        btn.BackgroundTransparency = (i == idx) and 0 or 1
        btn.TextColor3 = (i == idx) and Color3.new(1,1,1) or T.text
    end
    for i, page in ipairs(Pages) do page.Visible = (i == idx) end
end

local function CreateTab(name, idx)
    local btn = Instance.new("TextButton", TabBar)
    btn.Size, btn.Position = UDim2.new(1/3, 0, 1, 0), UDim2.new((idx-1)/3, 0, 0, 0)
    btn.BackgroundColor3, btn.BackgroundTransparency, btn.Text = T.accent, 1, name
    btn.TextColor3, btn.Font, btn.TextSize = T.text, Enum.Font.GothamBold, 12
    local page = Instance.new("ScrollingFrame", Content)
    page.Size, page.BackgroundTransparency, page.BorderSizePixel = UDim2.new(1, 0, 1, 0), 1, 0
    page.ScrollBarThickness, page.CanvasSize, page.Visible = 3, UDim2.new(0, 0, 0, 550), false
    table.insert(TabBtns, btn); table.insert(Pages, page)
    btn.MouseButton1Click:Connect(function() SwitchTab(idx) end)
    return page
end

local function AddToggle(parent, text, key, y)
    local btn = Instance.new("TextButton", parent)
    btn.Size, btn.Position = UDim2.new(1, -10, 0, 32), UDim2.new(0, 5, 0, y)
    btn.BackgroundColor3 = Fust.Config[key] and T.accent or Color3.fromRGB(240, 240, 240)
    btn.Text, btn.TextColor3 = "  " .. text, Fust.Config[key] and Color3.new(1,1,1) or T.text
    btn.Font, btn.TextSize, btn.TextXAlignment = Enum.Font.Gotham, 12, Enum.TextXAlignment.Left
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
    btn.MouseButton1Click:Connect(function()
        Fust.Config[key] = not Fust.Config[key]
        btn.BackgroundColor3 = Fust.Config[key] and T.accent or Color3.fromRGB(240, 240, 240)
        btn.TextColor3 = Fust.Config[key] and Color3.new(1,1,1) or T.text
    end)
end

local function AddSlider(parent, text, key, min, max, y)
    local f = Instance.new("Frame", parent)
    f.Size, f.Position, f.BackgroundTransparency = UDim2.new(1, -10, 0, 45), UDim2.new(0, 5, 0, y), 1
    local lbl = Instance.new("TextLabel", f)
    lbl.Size, lbl.BackgroundTransparency = UDim2.new(1, 0, 0, 20), 1
    lbl.Text, lbl.TextColor3 = text .. ": " .. Fust.Config[key], T.text
    lbl.Font, lbl.TextSize, lbl.TextXAlignment = Enum.Font.Gotham, 12, Enum.TextXAlignment.Left
    local bar = Instance.new("Frame", f)
    bar.Size, bar.Position, bar.BackgroundColor3 = UDim2.new(1, -10, 0, 6), UDim2.new(0, 5, 0, 25), T.track
    Instance.new("UICorner", bar).CornerRadius = UDim.new(1, 0)
    local fill = Instance.new("Frame", bar)
    fill.Size, fill.BackgroundColor3 = UDim2.new((Fust.Config[key] - min) / math.max(max - min, 1), 0, 1, 0), T.accent
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)
    local drag = false
    bar.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then drag = true end end)
    UserInputService.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then drag = false end end)
    UserInputService.InputChanged:Connect(function(i)
        if drag then
            local pos = math.clamp((i.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
            Fust.Config[key] = math.floor(min + (max - min) * pos)
            lbl.Text, fill.Size = text .. ": " .. Fust.Config[key], UDim2.new(pos, 0, 1, 0)
        end
    end)
end

local function AddTarget(parent, y)
    local bg = Instance.new("Frame", parent)
    bg.Size, bg.Position, bg.BackgroundTransparency = UDim2.new(1, -10, 0, 30), UDim2.new(0, 5, 0, y), 1
    local btnH = Instance.new("TextButton", bg)
    btnH.Size, btnH.Position, btnH.Text, btnH.Font, btnH.TextSize = UDim2.new(0.5, -5, 1, 0), UDim2.new(0, 0, 0, 0), "Head", Enum.Font.GothamBold, 12
    Instance.new("UICorner", btnH).CornerRadius = UDim.new(0, 6)
    local btnT = Instance.new("TextButton", bg)
    btnT.Size, btnT.Position, btnT.Text, btnT.Font, btnT.TextSize = UDim2.new(0.5, -5, 1, 0), UDim2.new(0.5, 5, 0, 0), "Torso", Enum.Font.GothamBold, 12
    Instance.new("UICorner", btnT).CornerRadius = UDim.new(0, 6)
    local function updateBtns()
        btnH.BackgroundColor3 = Fust.Config.Aim_Part == "Head" and T.accent or Color3.fromRGB(240,240,240)
        btnH.TextColor3 = Fust.Config.Aim_Part == "Head" and Color3.new(1,1,1) or T.text
        btnT.BackgroundColor3 = Fust.Config.Aim_Part == "Torso" and T.accent or Color3.fromRGB(240,240,240)
        btnT.TextColor3 = Fust.Config.Aim_Part == "Torso" and Color3.new(1,1,1) or T.text
    end
    btnH.MouseButton1Click:Connect(function() Fust.Config.Aim_Part = "Head"; updateBtns() end)
    btnT.MouseButton1Click:Connect(function() Fust.Config.Aim_Part = "Torso"; updateBtns() end)
    updateBtns()
end

