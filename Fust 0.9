workspace.DescendantAdded:Connect(function(inst)
    if not inst:IsA("BasePart") or not Config.BT_Enabled then return end
    local n = inst.Name:lower()
    if n:find("arrow") or n:find("bullet") or n:find("proj") or n:find("bolt") then
        if math.random(1,100) <= Config.BT_Chance then
            local target = Fust.GetTarget(500, Config.BT_Radius)
            if target then
                inst.Gravity = 0
                task.spawn(function()
                    while inst.Parent do
                        task.wait(0.03)
                        local hu = target.Parent and target.Parent:FindFirstChildOfClass("Humanoid")
                        if hu and hu.Health > 0 then
                            local d = (target.Position - inst.Position).Unit
                            inst.AssemblyLinearVelocity = d * 250
                            inst.CFrame = CFrame.lookAt(inst.Position, inst.Position + d)
                        else break end
                    end
                end)
            end
        end
    end
end)

