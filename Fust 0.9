                        e.n.Font = Enum.Font.GothamBold; e.n.TextSize = 11; e.n.TextStrokeTransparency = 0
                        e.icon.BackgroundTransparency = 1; e.icon.Size = UDim2.new(0, 30, 0, 30)
                        e.hpTxt.BackgroundTransparency = 1; e.hpTxt.TextColor3 = Color3.fromRGB(0,255,0)
                        e.hpTxt.Font = Enum.Font.GothamBold; e.hpTxt.TextSize = 10; e.hpTxt.TextStrokeTransparency = 0
                        espData[ch] = e
                    end
                    
                    local hh = math.abs(bp.Y - tp.Y)
                    e.b.Visible = Config.ESP_Boxes
                    e.b.Position = UDim2.new(0, tp.X - (hh*0.3), 0, tp.Y)
                    e.b.Size = UDim2.new(0, hh*0.6, 0, hh)
                    
                    e.n.Visible = Config.ESP_Names
                    e.n.Position = UDim2.new(0, tp.X - 75, 0, tp.Y - 16)
                    e.n.Size = UDim2.new(0, 150, 0, 14)
                    
                    local distStr = ""
                    if myRoot then distStr = " [" .. math.floor((r.Position - myRoot.Position).Magnitude) .. "m]" end
                    
                    local weapon = getWeaponName(ch)
                    if weapon then
                        e.n.Text = Config.ESP_WeaponText and (ch.Name .. " [" .. weapon .. "]" .. distStr) or (ch.Name .. distStr)
                        if Config.ESP_WeaponIcon then
                            e.icon.Visible = true
                            e.icon.Position = UDim2.new(0, tp.X - 15, 0, tp.Y - 50)
                            e.icon.Image = Icons[weapon] or Icons["Default"]
                        else e.icon.Visible = false end
                    else
                        e.n.Text = ch.Name .. distStr
                        e.icon.Visible = false
                    end
                    
                    e.hpTxt.Visible = Config.ESP_HP_Text
                    e.hpTxt.Position = UDim2.new(0, tp.X - 15, 1, 2)
                    e.hpTxt.Size = UDim2.new(0, 30, 0, 12)
                    e.hpTxt.Text = tostring(math.floor(hu.Health))
                else
                    if espData[ch] then 
                        espData[ch].b.Visible = false; espData[ch].n.Visible = false; espData[ch].icon.Visible = false
                        espData[ch].hpTxt.Visible = false
                    end
                end
            else
                if espData[ch] then 
                    espData[ch].b.Visible = false; espData[ch].n.Visible = false; espData[ch].icon.Visible = false
                    espData[ch].hpTxt.Visible = false
                end
            end
        end

        -- WORLD ESP (Только руды и ресурсы)
        local worldDraw = {}
        if Config.ESP_Wood or Config.ESP_Stone or Config.ESP_Sulfur or Config.ESP_Metal or Config.ESP_Cloth then
            for _, item in ipairs(worldESPObjects) do
                if item.obj and item.obj.Parent then
                    local dist = 0
                    if myRoot then dist = (item.pos - myRoot.Position).Magnitude end
                    
                    if dist <= Config.WorldESP_MaxDist then
                        local sp, on = Camera:WorldToViewportPoint(item.pos)
                        if on and sp.Z > 0 then
                            worldDraw[item.obj] = { pos = Vector2.new(sp.X, sp.Y), name = item.name, dist = math.floor(dist) }
                        end
                    end
                end
            end
        end

        for obj, data in pairs(worldDraw) do
            local e = espData[obj]
            if not e then
                e = { n = Instance.new("TextLabel", Gui) }
                e.n.BackgroundTransparency = 1; e.n.TextColor3 = Color3.fromRGB(255, 200, 50)
                e.n.Font = Enum.Font.GothamBold; e.n.TextSize = 11; e.n.TextStrokeTransparency = 0
                espData[obj] = e
            end
            e.n.Visible = true
            e.n.Position = UDim2.new(0, data.pos.X - 50, 0, data.pos.Y - 20)
            e.n.Size = UDim2.new(0, 100, 0, 14)
            e.n.Text = "[" .. data.name .. "] [" .. data.dist .. "m]"
        end

        -- Очистка
        for obj, e in pairs(espData) do
            if not obj.Parent or (not table.find(draw, obj) and not worldDraw[obj]) then
                if e.b then e.b:Destroy() end
                if e.n then e.n:Destroy() end
                if e.icon then e.icon:Destroy() end
                if e.hpTxt then e.hpTxt:Destroy() end
                espData[obj] = nil
            end
        end
    end)
end)
