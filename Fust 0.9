-- ЖЕЛЕЗНЫЙ ФИЛЬТР (Стены и мусор отсеиваются)
local function isResource(obj)
    local name = string.lower(obj.Name)
    
    -- Игнорируем всё, что похоже на постройки и мусор
    local blacklist = {"wall", "floor", "ceiling", "foundation", "door", "window", "stairs", "ramp", "building", "barricade", "prop", "decor", "rug", "light", "sign", "tool", "weapon", "gun"}
    for _, bad in ipairs(blacklist) do
        if string.find(name, bad) then return false end
    end
    
    -- Ищем только ресурсы
    local whitelist = {"ore", "node", "deposit", "resource", "sulfur", "metal", "wood", "log", "tree", "stone", "rock", "hemp", "cloth", "fabric", "scrap"}
    for _, good in ipairs(whitelist) do
        if string.find(name, good) then return true end
    end
    
    return false
end

-- Кэш ресурсов (обновляется раз в 2 сек)
task.spawn(function()
    while task.wait(2) do
        local newObjs = {}
        for _, v in ipairs(workspace:GetDescendants()) do
            if (v:IsA("BasePart") or v:IsA("Model")) and isResource(v) then
                local pos = nil
                if v:IsA("BasePart") then pos = v.Position
                elseif v:IsA("Model") and v.PrimaryPart then pos = v.PrimaryPart.Position
                elseif v:IsA("Model") and v:FindFirstChildWhichIsA("BasePart") then pos = v:FindFirstChildWhichIsA("BasePart").Position end
                
                if pos then
                    table.insert(newObjs, {obj = v, pos = pos, name = v.Name})
                end
            end
        end
        worldESPObjects = newObjs
    end
end)

local function getWeaponName(char)
    local tool = char:FindFirstChildWhichIsA("Tool")
    if tool then return tool.Name end
    local rightHand = char:FindFirstChild("RightHand") or char:FindFirstChild("Right Arm")
    if rightHand then
        local gunModel = rightHand:FindFirstChildOfClass("Model")
        if gunModel then return gunModel.Name end
    end
    return nil
end

