local Pages = {}
local TabBtns = {}

local function SwitchTab(idx)
    for i, btn in ipairs(TabBtns) do
        btn.BackgroundTransparency = (i == idx) and 0 or 1
        btn.TextColor3 = (i == idx) and Color3.new(1,1,1) or T.text
    end
    for i, page in ipairs(Pages) do
        page.Visible = (i == idx)
    end
end

local function CreateTab(name, idx)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1/3, 0, 1, 0)
    btn.Position = UDim2.new((idx-1)/3, 0, 0, 0)
    btn.BackgroundColor3 = T.accent
    btn.BackgroundTransparency = 1
    btn.Text = name
    btn.TextColor3 = T.text
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 12
    btn.Parent = TabBar
    
    local page = Instance.new("ScrollingFrame")
    page.Size = UDim2.new(1, 0, 1, 0)
    page.BackgroundTransparency = 1
    page.BorderSizePixel = 0
    page.ScrollBarThickness = 2
    page.ScrollBarImageColor3 = T.accent
    page.AutomaticCanvasSize = Enum.AutomaticSize.Y
    page.CanvasSize = UDim2.new(0, 0, 0, 0)
    page.Visible = false
    page.Parent = Content
    
    local layout = Instance.new("UIListLayout", page)
    layout.Padding = UDim.new(0, 5)
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    
    table.insert(TabBtns, btn)
    table.insert(Pages, page)
    btn.MouseButton1Click:Connect(function() SwitchTab(idx) end)
    return page
end

