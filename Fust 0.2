aimLine.BorderSizePixel = 0
aimLine.Visible = false
aimLine.ZIndex = 2
aimLine.Parent = Gui

local espData = {}
local botCache = {}

-- Фоновый поиск ботов (обновление раз в 1.5 секунды)
task.spawn(function()
    while task.wait(1.5) do
        local newCache = {}
        for _, v in ipairs(workspace:GetDescendants()) do
            if v:IsA("Model") and v:FindFirstChildOfClass("Humanoid") then
                if not Players:GetPlayerFromCharacter(v) then
                    table.insert(newCache, v)
                end
            end
        end
        botCache = newCache
    end
end)

local function isVisible(targetPart, targetChar)
    if not Config.Aim_VisibleCheck then return true end
    local rp = RaycastParams.new()
    rp.FilterDescendantsInstances = {LP.Character, targetChar}
    rp.FilterType = Enum.RaycastFilterType.Exclude
    local hit = workspace:Raycast(Camera.CFrame.Position, targetPart.Position - Camera.CFrame.Position, rp)
    return hit == nil
end

-- Экспортируем функцию поиска цели для Части 3 (Bullet Track)
function Fust.GetTargetByParams(fov, maxDist, checkVisible)
    local closest, minDist = nil, fov
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local myHead = LP.Character and LP.Character:FindFirstChild("Head")
    if not myHead then return nil end

    local function check(char)
        if not char then return end
        local part = char:FindFirstChild(Config.Aim_Part)
        local hum = char:FindFirstChildOfClass("Humanoid")
        if part and hum and hum.Health > 0 then
            local dist3d = (part.Position - myHead.Position).Magnitude
            if dist3d > maxDist then return end
            local sp, on = Camera:WorldToViewportPoint(part.Position)
            if on and sp.Z > 0 then
                local dist = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                if dist < minDist and (not checkVisible or isVisible(part, char)) then
                    minDist = dist
                    closest = part
                end
            end
        end
    end

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP then check(plr.Character) end
    end
    if Config.Aim_Bots then
        for _, v in ipairs(botCache) do check(v) end
    end
    return closest
end

RunService.RenderStepped:Connect(function()
    pcall(function()
        local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
        
        -- 1. FOV Circle
        if Config.Aim_Enabled and Config.Aim_ShowFOV then
            fovCircle.Visible = true
            fovCircle.Size = UDim2.new(0, Config.Aim_FOV * 2, 0, Config.Aim_FOV * 2)
        else
            fovCircle.Visible = false
        end

        -- 2. Aimbot & Aim Line
        aimLine.Visible = false
        if Config.Aim_Enabled then
            local target = Fust.GetTargetByParams(Config.Aim_FOV, 1500, Config.Aim_VisibleCheck)
            if target then
                local alpha = Config.Aim_Smooth / 10
                local targetCF = CFrame.lookAt(Camera.CFrame.Position, target.Position)
                Camera.CFrame = Camera.CFrame:Lerp(targetCF, alpha)

                local sp = Camera:WorldToViewportPoint(target.Position)
                local vec = Vector2.new(sp.X, sp.Y) - center
                local len = vec.Magnitude
                local angle = math.deg(math.atan2(vec.Y, vec.X))
                
                aimLine.Size = UDim2.new(0, len, 0, 1)
                aimLine.Position = UDim2.new(0, center.X, 0, center.Y)
                aimLine.Rotation = angle
                aimLine.Visible = true
            end
        end

        -- 3. ESP
        local entitiesToDraw = {}
        if Config.ESP_Enabled then
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= LP and plr.Character then table.insert(entitiesToDraw, plr.Character) end
            end
            if Config.ESP_Bots then
                for _, v in ipairs(botCache) do table.insert(entitiesToDraw, v) end
            end
        end

        for _, char in ipairs(entitiesToDraw) do
            local hum = char:FindFirstChildOfClass("Humanoid")
            local root = char:FindFirstChild("HumanoidRootPart")
            local head = char:FindFirstChild("Head")
            
            if hum and hum.Health > 0 and root and head then
                local topPos, topOn = Camera:WorldToViewportPoint(head.Position + Vector3.new(0,0.5,0))
                local botPos, botOn = Camera:WorldToViewportPoint(root.Position - Vector3.new(0,2.8,0))
                
                if topOn and botOn and topPos.Z > 0 then
                    local e = espData[char]
                    if not e then
                        e = { box = Instance.new("Frame", Gui), stroke = Instance.new("UIStroke"), name = Instance.new("TextLabel", Gui) }
                        e.box.BackgroundTransparency = 1; e.box.BorderSizePixel = 0
                        e.stroke.Thickness = 1.5; e.stroke.Parent = e.box
                        e.name.BackgroundTransparency = 1; e.name.TextColor3 = Color3.new(1,1,1)
                        e.name.Font = Enum.Font.GothamBold; e.name.TextSize = 12; e.name.TextStrokeTransparency = 0
                        espData[char] = e
                    end
                    
                    local visible = isVisible(head, char)
                    e.stroke.Color = visible and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 60, 60)
                    
                    local h = math.abs(botPos.Y - topPos.Y); local w = h * 0.6
                    e.box.Visible = Config.ESP_Boxes
                    e.box.Position = UDim2.new(0, topPos.X - (w/2), 0, topPos.Y)
                    e.box.Size = UDim2.new(0, w, 0, h)
                    
                    e.name.Visible = Config.ESP_Names
                    e.name.Position = UDim2.new(0, topPos.X - 50, 0, topPos.Y - 18)
                    e.name.Size = UDim2.new(0, 100, 0, 15)
                    e.name.Text = char.Name
                elseif espData[char] then 
                    espData[char].box.Visible = false; espData[char].name.Visible = false 
                end
            elseif espData[char] then 
                espData[char].box.Visible = false; espData[char].name.Visible = false 
            end
        end

        -- Очистка "призраков" ESP
        for char, e in pairs(espData) do
            local hum = char:FindFirstChildOfClass("Humanoid")
            if not char.Parent or not hum or hum.Health <= 0 or not table.find(entitiesToDraw, char) then
                e.box:Destroy()
                e.name:Destroy()
                espData[char] = nil
            end
        end
    end)
end)
