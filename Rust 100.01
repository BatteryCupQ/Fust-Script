-- ============================================================
-- RUST SCRIPT — PART 1/5 : CONFIG + WINDOW + HEADER
-- Выполни ПЕРВОЙ.
-- ============================================================
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local LP = Players.LocalPlayer
local PlayerGui = LP:WaitForChild("PlayerGui")

_G.Fust = _G.Fust or {}
local Fust = _G.Fust

Fust.Config = {
    ESP_Enabled = true, ESP_Boxes = true, ESP_Names = true, ESP_Bots = true,
    ESP_WeaponText = true, ESP_WeaponIcon = false, ESP_HP_Text = true,
    ESP_Wood = false, ESP_Stone = false, ESP_Sulfur = true, ESP_Metal = false, ESP_Cloth = false,
    ESP_HumanMaxDist = 500, WorldESP_MaxDist = 500,
    Aim_Enabled = true, Aim_Bots = true, Aim_VisibleCheck = true, Aim_Part = "Head",
    Aim_Smooth = 3, Aim_FOV = 150, Aim_ShowFOV = true, Aim_MaxDist = 500,
    BT_Enabled = false, BT_Chance = 100, BT_Radius = 500,
    NightVision = false
}

if PlayerGui:FindFirstChild("FustUI") then PlayerGui.FustUI:Destroy() end

local T = {
    bg=Color3.fromRGB(18,18,24), bgLight=Color3.fromRGB(28,28,36), bgLighter=Color3.fromRGB(38,38,48),
    text=Color3.fromRGB(235,235,245), textDim=Color3.fromRGB(150,150,165),
    accent=Color3.fromRGB(120,90,255), accentDark=Color3.fromRGB(90,60,220), accentGlow=Color3.fromRGB(150,120,255),
    green=Color3.fromRGB(80,220,120), red=Color3.fromRGB(255,80,100),
    stroke=Color3.fromRGB(55,55,70), track=Color3.fromRGB(45,45,60)
}
Fust.Theme = T

local Gui = Instance.new("ScreenGui")
Gui.Name = "FustUI"; Gui.ResetOnSpawn = false; Gui.IgnoreGuiInset = true
Gui.DisplayOrder = 999; Gui.Parent = PlayerGui
Fust.Gui = Gui

-- Счётчик
local CounterFrame = Instance.new("Frame", Gui)
CounterFrame.Size = UDim2.new(0,170,0,34)
CounterFrame.Position = UDim2.new(1,-185,0,20)
CounterFrame.BackgroundColor3 = T.bgLight
CounterFrame.BackgroundTransparency = 0.15
Instance.new("UICorner", CounterFrame).CornerRadius = UDim.new(0,10)
local cStroke = Instance.new("UIStroke", CounterFrame)
cStroke.Color = T.accent; cStroke.Thickness = 1.5; cStroke.Transparency = 0.3

local CounterText = Instance.new("TextLabel", CounterFrame)
CounterText.Size = UDim2.new(1,0,1,0); CounterText.BackgroundTransparency = 1
CounterText.Text = "👥 0  |  🤖 0"; CounterText.TextColor3 = T.text
CounterText.Font = Enum.Font.GothamBold; CounterText.TextSize = 13
Fust.CounterText = CounterText

-- Главное окно
local Main = Instance.new("Frame", Gui)
local MainFullSize = UDim2.new(0,380,0,420)
Main.Size = MainFullSize
Main.Position = UDim2.new(0.5,-190,0.5,-210)
Main.BackgroundColor3 = T.bg; Main.BorderSizePixel = 0
Instance.new("UICorner", Main).CornerRadius = UDim.new(0,12)
local mStroke = Instance.new("UIStroke", Main)
mStroke.Color = T.stroke; mStroke.Thickness = 1
local mGrad = Instance.new("UIGradient", Main)
mGrad.Color = ColorSequence.new(T.bg,T.bgLight); mGrad.Rotation = 90

local shadow = Instance.new("ImageLabel", Main)
shadow.Size = UDim2.new(1,30,1,30); shadow.Position = UDim2.new(0,-15,0,-15)
shadow.BackgroundTransparency = 1; shadow.Image = "rbxassetid://6014261993"
shadow.ImageColor3 = Color3.new(0,0,0); shadow.ImageTransparency = 0.6
shadow.ScaleType = Enum.ScaleType.Slice
shadow.SliceCenter = Rect.new(49,49,450,450); shadow.ZIndex = -1

-- Шапка
local Header = Instance.new("Frame", Main)
Header.Size = UDim2.new(1,0,0,42); Header.BackgroundColor3 = T.bgLight
Header.BorderSizePixel = 0
Instance.new("UICorner", Header).CornerRadius = UDim.new(0,12)
local hCover = Instance.new("Frame", Header)
hCover.Size = UDim2.new(1,0,0.5,0); hCover.Position = UDim2.new(0,0,0.5,0)
hCover.BackgroundColor3 = T.bgLight; hCover.BorderSizePixel = 0
local hGrad = Instance.new("UIGradient", Header)
hGrad.Color = ColorSequence.new(T.bgLighter,T.bgLight); hGrad.Rotation = 90

local logo = Instance.new("TextLabel", Header)
logo.Size = UDim2.new(0,32,0,32); logo.Position = UDim2.new(0,10,0,5)
logo.BackgroundColor3 = T.accent; logo.Text = "R"; logo.TextColor3 = Color3.new(1,1,1)
logo.Font = Enum.Font.GothamBlack; logo.TextSize = 18
Instance.new("UICorner", logo).CornerRadius = UDim.new(0,8)
local lGrad = Instance.new("UIGradient", logo)
lGrad.Color = ColorSequence.new(T.accentGlow,T.accentDark); lGrad.Rotation = 45

local Title = Instance.new("TextLabel", Header)
Title.Size = UDim2.new(1,-100,1,0); Title.Position = UDim2.new(0,48,0,0)
Title.BackgroundTransparency = 1; Title.Text = "Rust Script"
Title.TextColor3 = T.text; Title.Font = Enum.Font.GothamBold; Title.TextSize = 16
Title.TextXAlignment = Enum.TextXAlignment.Left

local Version = Instance.new("TextLabel", Header)
Version.Size = UDim2.new(0,50,0,14); Version.Position = UDim2.new(1,-110,0,14)
Version.BackgroundTransparency = 1; Version.Text = "v2.0"
Version.TextColor3 = T.textDim; Version.Font = Enum.Font.Gotham; Version.TextSize = 10
Version.TextXAlignment = Enum.TextXAlignment.Right

-- Перетаскивание
local drag, dragStart, startPos
Header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        drag = true; dragStart = input.Position; startPos = Main.Position
    end
end)
UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then drag = false end
end)
UserInputService.InputChanged:Connect(function(input)
    if drag and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        Main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset+delta.X, startPos.Y.Scale, startPos.Y.Offset+delta.Y)
    end
end)

-- Сохраняем ссылки
Fust.Main = Main
Fust.MainFullSize = MainFullSize
Fust.Header = Header

print("[Rust Script] Part 1/5 loaded — Window ready")

-- ============================================================
-- RUST SCRIPT — PART 2/5 : TABS + COMPONENTS
-- Выполни ВТОРОЙ.
-- ============================================================
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local Fust = _G.Fust

if not Fust or not Fust.Main then
    warn("[Rust Script] Part 2/5: сначала выполни Part 1/5!")
    return
end
local Config = Fust.Config
local Main = Fust.Main
local T = Fust.Theme

-- Вкладки
local TabBar = Instance.new("Frame", Main)
TabBar.Size = UDim2.new(1,-20,0,34); TabBar.Position = UDim2.new(0,10,0,50)
TabBar.BackgroundColor3 = T.bgLight; TabBar.BorderSizePixel = 0
Instance.new("UICorner", TabBar).CornerRadius = UDim.new(0,8)
local tbStroke = Instance.new("UIStroke", TabBar)
tbStroke.Color = T.stroke; tbStroke.Thickness = 1

local Content = Instance.new("Frame", Main)
Content.Size = UDim2.new(1,-20,1,-100); Content.Position = UDim2.new(0,10,0,90)
Content.BackgroundTransparency = 1

Fust.TabBar = TabBar
Fust.Content = Content

local Pages, TabBtns = {}, {}
local function SwitchTab(idx)
    for i, btn in ipairs(TabBtns) do
        local isActive = (i == idx)
        btn.BackgroundTransparency = isActive and 0 or 1
        btn.TextColor3 = isActive and Color3.new(1,1,1) or T.textDim
    end
    for i, page in ipairs(Pages) do page.Visible = (i == idx) end
end
Fust.SwitchTab = SwitchTab

function Fust.CreateTab(name, idx)
    local btn = Instance.new("TextButton", TabBar)
    btn.Size = UDim2.new(1/3,-4,1,-6)
    btn.Position = UDim2.new((idx-1)/3, 2+(idx-1)*1, 0, 3)
    btn.BackgroundColor3 = T.accent; btn.BackgroundTransparency = 1
    btn.Text = name; btn.TextColor3 = T.textDim
    btn.Font = Enum.Font.GothamBold; btn.TextSize = 12; btn.BorderSizePixel = 0
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0,6)
    local g = Instance.new("UIGradient", btn)
    g.Color = ColorSequence.new(T.accentGlow,T.accentDark); g.Rotation = 45

    local page = Instance.new("Frame", Content)
    page.Size = UDim2.new(1,0,1,0); page.BackgroundTransparency = 1; page.Visible = false

    table.insert(TabBtns, btn); table.insert(Pages, page)
    btn.MouseButton1Click:Connect(function() SwitchTab(idx) end)
    return page
end

-- Под-вкладки
function Fust.CreateSubTabs(parent, name1, name2, page1, page2)
    local subBar = Instance.new("Frame", parent)
    subBar.Size = UDim2.new(1,-10,0,28); subBar.Position = UDim2.new(0,5,0,0)
    subBar.BackgroundColor3 = T.bgLighter; subBar.BackgroundTransparency = 0.3
    subBar.BorderSizePixel = 0
    Instance.new("UICorner", subBar).CornerRadius = UDim.new(0,6)

    local btn1 = Instance.new("TextButton", subBar)
    btn1.Size = UDim2.new(0.5,-3,1,-4); btn1.Position = UDim2.new(0,2,0,2)
    btn1.Text, btn1.Font, btn1.TextSize = name1, Enum.Font.GothamBold, 11
    btn1.BackgroundColor3 = T.accent; btn1.TextColor3 = Color3.new(1,1,1); btn1.BorderSizePixel = 0
    Instance.new("UICorner", btn1).CornerRadius = UDim.new(0,5)

    local btn2 = Instance.new("TextButton", subBar)
    btn2.Size = UDim2.new(0.5,-3,1,-4); btn2.Position = UDim2.new(0.5,1,0,2)
    btn2.Text, btn2.Font, btn2.TextSize = name2, Enum.Font.GothamBold, 11
    btn2.BackgroundColor3 = T.accent; btn2.BackgroundTransparency = 1
    btn2.TextColor3 = T.textDim; btn2.BorderSizePixel = 0
    Instance.new("UICorner", btn2).CornerRadius = UDim.new(0,5)

    page1.Visible = true; page2.Visible = false
    page1.Size = UDim2.new(1,-10,1,-35); page1.Position = UDim2.new(0,5,0,35); page1.BackgroundTransparency = 1
    page2.Size = UDim2.new(1,-10,1,-35); page2.Position = UDim2.new(0,5,0,35); page2.BackgroundTransparency = 1
    page1.Parent = parent; page2.Parent = parent

    btn1.MouseButton1Click:Connect(function()
        page1.Visible = true; page2.Visible = false
        btn1.BackgroundTransparency = 0; btn1.TextColor3 = Color3.new(1,1,1)
        btn2.BackgroundTransparency = 1; btn2.TextColor3 = T.textDim
    end)
    btn2.MouseButton1Click:Connect(function()
        page1.Visible = false; page2.Visible = true
        btn2.BackgroundTransparency = 0; btn2.TextColor3 = Color3.new(1,1,1)
        btn1.BackgroundTransparency = 1; btn1.TextColor3 = T.textDim
    end)
end

-- Toggle
function Fust.AddToggle(parent, text, key, y)
    local btn = Instance.new("TextButton", parent)
    btn.Size = UDim2.new(1,0,0,34); btn.Position = UDim2.new(0,0,0,y)
    btn.BackgroundColor3 = T.bgLight; btn.BackgroundTransparency = 0.1
    btn.Text = ""; btn.BorderSizePixel = 0; btn.AutoButtonColor = false
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0,7)
    local stroke = Instance.new("UIStroke", btn)
    stroke.Color = T.stroke; stroke.Thickness = 1

    local lbl = Instance.new("TextLabel", btn)
    lbl.Size = UDim2.new(1,-50,1,0); lbl.Position = UDim2.new(0,12,0,0)
    lbl.BackgroundTransparency = 1; lbl.Text = text; lbl.TextColor3 = T.text
    lbl.Font = Enum.Font.Gotham; lbl.TextSize = 12; lbl.TextXAlignment = Enum.TextXAlignment.Left

    local swBg = Instance.new("Frame", btn)
    swBg.Size = UDim2.new(0,32,0,18); swBg.Position = UDim2.new(1,-42,0.5,-9)
    swBg.BackgroundColor3 = Config[key] and T.accent or T.track; swBg.BorderSizePixel = 0
    Instance.new("UICorner", swBg).CornerRadius = UDim.new(1,0)

    local knob = Instance.new("Frame", swBg)
    knob.Size = UDim2.new(0,14,0,14)
    knob.Position = Config[key] and UDim2.new(1,-16,0.5,-7) or UDim2.new(0,2,0.5,-7)
    knob.BackgroundColor3 = Color3.new(1,1,1); knob.BorderSizePixel = 0
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1,0)

    btn.MouseButton1Click:Connect(function()
        Config[key] = not Config[key]
        local on = Config[key]
        TweenService:Create(swBg, TweenInfo.new(0.2), {BackgroundColor3 = on and T.accent or T.track}):Play()
        TweenService:Create(knob, TweenInfo.new(0.2), {
            Position = on and UDim2.new(1,-16,0.5,-7) or UDim2.new(0,2,0.5,-7)
        }):Play()
    end)
end

-- Slider
function Fust.AddSlider(parent, text, key, min, max, y)
    local f = Instance.new("Frame", parent)
    f.Size = UDim2.new(1,0,0,50); f.Position = UDim2.new(0,0,0,y); f.BackgroundTransparency = 1

    local lbl = Instance.new("TextLabel", f)
    lbl.Size = UDim2.new(1,-70,0,18); lbl.BackgroundTransparency = 1
    lbl.Text = text; lbl.TextColor3 = T.text; lbl.Font = Enum.Font.Gotham
    lbl.TextSize = 12; lbl.TextXAlignment = Enum.TextXAlignment.Left

    local valLbl = Instance.new("TextLabel", f)
    valLbl.Size = UDim2.new(0,60,0,18); valLbl.Position = UDim2.new(1,-60,0,0)
    valLbl.BackgroundTransparency = 1; valLbl.Text = tostring(Config[key])
    valLbl.TextColor3 = T.accentGlow; valLbl.Font = Enum.Font.GothamBold
    valLbl.TextSize = 12; valLbl.TextXAlignment = Enum.TextXAlignment.Right

    local bar = Instance.new("Frame", f)
    bar.Size = UDim2.new(1,0,0,8); bar.Position = UDim2.new(0,0,0,28)
    bar.BackgroundColor3 = T.track; bar.BorderSizePixel = 0
    Instance.new("UICorner", bar).CornerRadius = UDim.new(1,0)

    local fill = Instance.new("Frame", bar)
    fill.Size = UDim2.new((Config[key]-min)/math.max(max-min,1),0,1,0)
    fill.BackgroundColor3 = T.accent; fill.BorderSizePixel = 0
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1,0)
    local fGrad = Instance.new("UIGradient", fill)
    fGrad.Color = ColorSequence.new(T.accentGlow,T.accentDark)

    local knob = Instance.new("Frame", bar)
    knob.Size = UDim2.new(0,14,0,14)
    knob.Position = UDim2.new((Config[key]-min)/math.max(max-min,1),0,0.5,-7)
    knob.BackgroundColor3 = Color3.new(1,1,1); knob.BorderSizePixel = 0
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1,0)
    local kStroke = Instance.new("UIStroke", knob)
    kStroke.Color = T.accent; kStroke.Thickness = 2

    local drag = false
    bar.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then drag = true end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then drag = false end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if drag then
            local pos = math.clamp((i.Position.X - bar.AbsolutePosition.X)/bar.AbsoluteSize.X, 0, 1)
            Config[key] = math.floor(min + (max-min)*pos)
            valLbl.Text = tostring(Config[key])
            fill.Size = UDim2.new(pos,0,1,0)
            knob.Position = UDim2.new(pos,0,0.5,-7)
        end
    end)
end

print("[Rust Script] Part 2/5 loaded — Tabs & components ready")

-- ============================================================
-- RUST SCRIPT — PART 3/5 : ESP PAGE + AIMBOT PAGE
-- Выполни ТРЕТЬЕЙ.
-- ============================================================
local Fust = _G.Fust

if not Fust or not Fust.Main or not Fust.CreateTab then
    warn("[Rust Script] Part 3/5: сначала выполни Part 1/5 и 2/5!")
    return
end
local Config = Fust.Config
local T = Fust.Theme
local AddToggle = Fust.AddToggle
local AddSlider = Fust.AddSlider
local CreateSubTabs = Fust.CreateSubTabs
local CreateTab = Fust.CreateTab

-- ===== ESP PAGE =====
local p1 = CreateTab("ESP", 1)
local espHumFrame = Instance.new("ScrollingFrame", p1)
local espWorldFrame = Instance.new("ScrollingFrame", p1)
espHumFrame.ScrollBarThickness = 2; espHumFrame.CanvasSize = UDim2.new(0,0,0,260)
espHumFrame.ScrollBarImageColor3 = T.accent; espHumFrame.BorderSizePixel = 0
espHumFrame.BackgroundTransparency = 1
espWorldFrame.ScrollBarThickness = 2; espWorldFrame.CanvasSize = UDim2.new(0,0,0,260)
espWorldFrame.ScrollBarImageColor3 = T.accent; espWorldFrame.BorderSizePixel = 0
espWorldFrame.BackgroundTransparency = 1
CreateSubTabs(p1, "Human ESP", "World ESP", espHumFrame, espWorldFrame)

AddToggle(espHumFrame, "Enable ESP", "ESP_Enabled", 0)
AddToggle(espHumFrame, "Draw Boxes", "ESP_Boxes", 38)
AddToggle(espHumFrame, "Draw Names", "ESP_Names", 76)
AddToggle(espHumFrame, "Bot ESP (NPCs)", "ESP_Bots", 114)
AddToggle(espHumFrame, "HP Text", "ESP_HP_Text", 152)
AddToggle(espHumFrame, "Weapon Text", "ESP_WeaponText", 190)
AddToggle(espHumFrame, "Weapon Icon", "ESP_WeaponIcon", 228)

AddToggle(espWorldFrame, "Wood ESP", "ESP_Wood", 0)
AddToggle(espWorldFrame, "Stone ESP", "ESP_Stone", 38)
AddToggle(espWorldFrame, "Sulfur ESP", "ESP_Sulfur", 76)
AddToggle(espWorldFrame, "Metal ESP", "ESP_Metal", 114)
AddToggle(espWorldFrame, "Cloth ESP", "ESP_Cloth", 152)
AddSlider(espWorldFrame, "Max Distance (m)", "WorldESP_MaxDist", 0, 500, 195)

-- ===== AIMBOT PAGE =====
local p2 = CreateTab("Aimbot", 2)
local aimFrame = Instance.new("ScrollingFrame", p2)
local btFrame = Instance.new("ScrollingFrame", p2)
aimFrame.ScrollBarThickness = 2; aimFrame.CanvasSize = UDim2.new(0,0,0,340)
aimFrame.ScrollBarImageColor3 = T.accent; aimFrame.BorderSizePixel = 0
aimFrame.BackgroundTransparency = 1
btFrame.ScrollBarThickness = 2; btFrame.CanvasSize = UDim2.new(0,0,0,160)
btFrame.ScrollBarImageColor3 = T.accent; btFrame.BorderSizePixel = 0
btFrame.BackgroundTransparency = 1
CreateSubTabs(p2, "Aimbot", "Bullet Track", aimFrame, btFrame)

AddToggle(aimFrame, "Enable Aimbot", "Aim_Enabled", 0)
AddToggle(aimFrame, "Bot Aim (NPCs)", "Aim_Bots", 38)
AddToggle(aimFrame, "Visible Check", "Aim_VisibleCheck", 76)
AddToggle(aimFrame, "Show FOV Circle", "Aim_ShowFOV", 114)

-- Выбор части тела
local targetBg = Instance.new("Frame", aimFrame)
targetBg.Size = UDim2.new(1,0,0,34); targetBg.Position = UDim2.new(0,0,0,152)
targetBg.BackgroundColor3 = T.bgLight; targetBg.BackgroundTransparency = 0.1
targetBg.BorderSizePixel = 0
Instance.new("UICorner", targetBg).CornerRadius = UDim.new(0,7)
local tStroke = Instance.new("UIStroke", targetBg)
tStroke.Color = T.stroke; tStroke.Thickness = 1

local btnH = Instance.new("TextButton", targetBg)
btnH.Size = UDim2.new(0.5,-4,1,-8); btnH.Position = UDim2.new(0,3,0,4)
btnH.Text, btnH.Font, btnH.TextSize = "Head", Enum.Font.GothamBold, 12
btnH.BorderSizePixel = 0
Instance.new("UICorner", btnH).CornerRadius = UDim.new(0,5)

local btnT = Instance.new("TextButton", targetBg)
btnT.Size = UDim2.new(0.5,-4,1,-8); btnT.Position = UDim2.new(0.5,1,0,4)
btnT.Text, btnT.Font, btnT.TextSize = "Torso", Enum.Font.GothamBold, 12
btnT.BorderSizePixel = 0
Instance.new("UICorner", btnT).CornerRadius = UDim.new(0,5)

local function updateBtns()
    btnH.BackgroundColor3 = Config.Aim_Part == "Head" and T.accent or T.bgLighter
    btnH.TextColor3 = Config.Aim_Part == "Head" and Color3.new(1,1,1) or T.textDim
    btnT.BackgroundColor3 = Config.Aim_Part == "Torso" and T.accent or T.bgLighter
    btnT.TextColor3 = Config.Aim_Part == "Torso" and Color3.new(1,1,1) or T.textDim
end
btnH.MouseButton1Click:Connect(function() Config.Aim_Part = "Head"; updateBtns() end)
btnT.MouseButton1Click:Connect(function() Config.Aim_Part = "Torso"; updateBtns() end)
updateBtns()

AddSlider(aimFrame, "Smoothness", "Aim_Smooth", 1, 10, 195)
AddSlider(aimFrame, "FOV Size", "Aim_FOV", 50, 500, 250)
AddSlider(aimFrame, "Max Distance (m)", "Aim_MaxDist", 100, 1000, 305)

AddToggle(btFrame, "Enable Bullet Track", "BT_Enabled", 0)
AddSlider(btFrame, "BT Chance", "BT_Chance", 1, 100, 38)
AddSlider(btFrame, "BT Radius", "BT_Radius", 100, 2000, 93)

print("[Rust Script] Part 3/5 loaded — ESP & Aimbot pages ready")

-- ============================================================
-- RUST SCRIPT — PART 4/5 : VISUALS + MINIMIZE + CORE LOGIC
-- Выполни ЧЕТВЁРТОЙ.
-- ============================================================
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Camera = workspace.CurrentCamera
local LP = Players.LocalPlayer
local Fust = _G.Fust

if not Fust or not Fust.Main or not Fust.CreateTab then
    warn("[Rust Script] Part 4/5: сначала выполни Part 1-3!")
    return
end
local Config = Fust.Config
local Gui = Fust.Gui
local T = Fust.Theme
local Main = Fust.Main
local Header = Fust.Header
local TabBar = Fust.TabBar
local Content = Fust.Content

-- ===== VISUALS PAGE =====
local p3 = Fust.CreateTab("Visuals", 3)
local visScroll = Instance.new("ScrollingFrame", p3)
visScroll.Size = UDim2.new(1,0,1,0); visScroll.BackgroundTransparency = 1
visScroll.BorderSizePixel = 0; visScroll.ScrollBarThickness = 2
visScroll.ScrollBarImageColor3 = T.accent
Fust.AddToggle(visScroll, "Night Vision", "NightVision", 0)
Fust.SwitchTab(1)

-- ===== КНОПКА СВОРАЧИВАНИЯ =====
local isMinimized = false
local MinBtn = Instance.new("TextButton", Header)
MinBtn.Size = UDim2.new(0,28,0,28); MinBtn.Position = UDim2.new(1,-38,0,7)
MinBtn.BackgroundColor3 = T.bgLighter; MinBtn.Text = "—"
MinBtn.TextColor3 = T.text; MinBtn.Font = Enum.Font.GothamBold
MinBtn.TextSize = 15; MinBtn.BorderSizePixel = 0; MinBtn.AutoButtonColor = false
Instance.new("UICorner", MinBtn).CornerRadius = UDim.new(0,7)

MinBtn.MouseButton1Click:Connect(function()
    isMinimized = not isMinimized
    if isMinimized then
        TabBar.Visible = false; Content.Visible = false
        TweenService:Create(Main, TweenInfo.new(0.25), {Size = UDim2.new(0,380,0,42)}):Play()
        MinBtn.Text = "+"
    else
        TabBar.Visible = true; Content.Visible = true
        TweenService:Create(Main, TweenInfo.new(0.25), {Size = Fust.MainFullSize}):Play()
        MinBtn.Text = "—"
    end
end)

-- ===== FOV CIRCLE =====
local fovCircle = Instance.new("Frame", Gui)
fovCircle.AnchorPoint = Vector2.new(0.5,0.5)
fovCircle.Position = UDim2.new(0.5,0,0.5,0)
fovCircle.BackgroundTransparency = 1; fovCircle.BorderSizePixel = 0
Instance.new("UICorner", fovCircle).CornerRadius = UDim.new(0.5,0)
local fovStroke = Instance.new("UIStroke", fovCircle)
fovStroke.Color = T.accentGlow; fovStroke.Thickness = 1.5; fovStroke.Transparency = 0.3

-- ===== ВАЛИДАЦИЯ =====
function Fust.IsValid(char)
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    local state = hum:GetState()
    if state == Enum.HumanoidStateType.Dead or state == Enum.HumanoidStateType.Physics then return false end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root or root.Anchored then return false end
    return true
end

local function isVis(part, char)
    if not Config.Aim_VisibleCheck then return true end
    local rp = RaycastParams.new()
    rp.FilterDescendantsInstances = {LP.Character, char}
    rp.FilterType = Enum.RaycastFilterType.Exclude
    return workspace:Raycast(Camera.CFrame.Position, part.Position - Camera.CFrame.Position, rp) == nil
end

-- ===== ПОИСК ЦЕЛИ =====
function Fust.GetTarget(fov, dist)
    local best, minD = nil, fov
    local ctr = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    local mh = LP.Character and LP.Character:FindFirstChild("Head")
    if not mh then return nil end

    local function chk(ch)
        if not Fust.IsValid(ch) then return end
        local h = ch:FindFirstChild(Config.Aim_Part)
        if h and (h.Position - mh.Position).Magnitude <= dist then
            local sp, on = Camera:WorldToViewportPoint(h.Position)
            if on and sp.Z > 0 then
                local d2 = (Vector2.new(sp.X, sp.Y) - ctr).Magnitude
                if d2 < minD and isVis(h, ch) then minD = d2; best = h end
            end
        end
    end

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP then chk(plr.Character) end
    end
    if Config.Aim_Bots or Config.BT_Enabled then
        for _, b in ipairs(Fust.BotCache or {}) do chk(b) end
    end
    return best
end

-- ===== КЭШ БОТОВ =====
task.spawn(function()
    while task.wait(2) do
        local newCache = {}
        if Config.ESP_Bots or Config.Aim_Bots or Config.BT_Enabled then
            for _, v in ipairs(workspace:GetDescendants()) do
                if v:IsA("Model") and Fust.IsValid(v) and not Players:GetPlayerFromCharacter(v) then
                    table.insert(newCache, v)
                end
            end
        end
        Fust.BotCache = newCache
    end
end)

-- ===== СЧЁТЧИК =====
task.spawn(function()
    while task.wait(2) do
        local pc, bc = 0, 0
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LP and Fust.IsValid(plr.Character) then pc = pc + 1 end
        end
        for _, b in ipairs(Fust.BotCache or {}) do
            if Fust.IsValid(b) then bc = bc + 1 end
        end
        if Fust.CounterText then
            Fust.CounterText.Text = string.format("👥 %d  |  🤖 %d", pc, bc)
        end
    end
end)

-- ===== BULLET TRACK =====
workspace.DescendantAdded:Connect(function(inst)
    if not inst:IsA("BasePart") or not Config.BT_Enabled then return end
    local n = inst.Name:lower()
    if n:find("arrow") or n:find("bullet") or n:find("proj") or n:find("bolt") then
        if math.random(1,100) <= Config.BT_Chance then
            local target = Fust.GetTarget(500, Config.BT_Radius)
            if target then
                inst.Gravity = 0
                task.spawn(function()
                    while inst.Parent do
                        task.wait(0.03)
                        local hu = target.Parent and target.Parent:FindFirstChildOfClass("Humanoid")
                        if hu and hu.Health > 0 then
                            local d = (target.Position - inst.Position).Unit
                            inst.AssemblyLinearVelocity = d * 250
                            inst.CFrame = CFrame.lookAt(inst.Position, inst.Position + d)
                        else break end
                    end
                end)
            end
        end
    end
end)

-- ===== ГЛАВНЫЙ ЦИКЛ =====
local lastAim = 0
RunService.RenderStepped:Connect(function()
    local now = tick()
    if now - lastAim < 0.03 then return end
    lastAim = now

    pcall(function()
        if Config.NightVision then
            if game:GetService("Lighting").ClockTime ~= 14 then
                game:GetService("Lighting").ClockTime = 14
            end
        end

        if Config.Aim_Enabled and Config.Aim_ShowFOV then
            fovCircle.Visible = true
            fovCircle.Size = UDim2.new(0, Config.Aim_FOV*2, 0, Config.Aim_FOV*2)
        else
            fovCircle.Visible = false
        end

        if Config.Aim_Enabled and not Config.BT_Enabled then
            local target = Fust.GetTarget(Config.Aim_FOV, Config.Aim_MaxDist)
            if target then
                Camera.CFrame = Camera.CFrame:Lerp(
                    CFrame.lookAt(Camera.CFrame.Position, target.Position),
                    Config.Aim_Smooth / 10
                )
            end
        end
    end)
end)

print("[Rust Script] Part 4/5 loaded — Visuals + Core logic ready")

-- ============================================================
-- RUST SCRIPT — PART 5/5 : ESP (HUMAN + WORLD, OPTIMIZED)
-- Выполни ПЯТОЙ.
-- ============================================================
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Camera = workspace.CurrentCamera
local LP = Players.LocalPlayer
local Fust = _G.Fust

if not Fust or not Fust.Gui or not Fust.Config then
    warn("[Rust Script] Part 5/5: сначала выполни Part 1-4!")
    return
end
local Config = Fust.Config
local Gui = Fust.Gui

local Icons = {
    ["AK-47"] = "rbxassetid://112199877713402",
    ["M4A1"] = "rbxassetid://112199886750135",
    Default = "rbxassetid://1316045217"
}
local espData = {}
local worldESPObjects = {}

-- ===== ОПТИМИЗАЦИЯ =====
local ESP_INTERVAL = 0.05
local RES_REFRESH = 4
local MAX_WORLD = 150
local MAX_HUMAN = 30
local lastUpdate = 0

-- ===== ПУЛ ЛЕЙБЛОВ =====
local labelPool = {}
local function getLabel()
    local l = table.remove(labelPool)
    if l and l.Parent then return l end
    l = Instance.new("TextLabel", Gui)
    l.BackgroundTransparency = 1
    l.Font = Enum.Font.GothamBold
    l.TextSize = 11
    l.TextStrokeTransparency = 0
    l.Visible = false
    return l
end
local function releaseLabel(l)
    if l then l.Visible = false; table.insert(labelPool, l) end
end

-- ===== ФИЛЬТР РЕСУРСОВ =====
local function getResourceType(obj)
    local n = string.lower(obj.Name)
    local bad = {"wall","floor","ceiling","foundation","door","window","stairs","ramp","building","barricade","prop","decor","rug","light","sign","tool","weapon","gun","box","chest","lid","storage","bag","sack","cupboard","workbench","furnace","deployed"}
    for _, b in ipairs(bad) do
        if string.find(n, b) then return nil end
    end
    if string.find(n,"hemp") or string.find(n,"fabric") or string.find(n,"cloth") or string.find(n,"fiber") then
        return "Cloth"
    end
    if string.find(n,"node") or string.find(n,"ore") then
        if string.find(n,"sulfur") or string.find(n,"sulphur") then return "Sulfur" end
        if string.find(n,"metal") or string.find(n,"iron") or string.find(n,"copper") then return "Metal" end
        if string.find(n,"stone") or string.find(n,"rock") then return "Stone" end
        return "Stone"
    end
    if string.find(n,"tree") or string.find(n,"log") then return "Wood" end
    return nil
end

-- ===== КЭШ РЕСУРСОВ =====
task.spawn(function()
    while task.wait(RES_REFRESH) do
        local any = Config.ESP_Wood or Config.ESP_Stone or Config.ESP_Sulfur or Config.ESP_Metal or Config.ESP_Cloth
        if not any then worldESPObjects = {}; continue end
        local newObjs, count = {}, 0
        for _, v in ipairs(workspace:GetDescendants()) do
            if count >= 500 then break end
            if v:IsA("BasePart") or v:IsA("Model") then
                local r = getResourceType(v)
                if r then
                    local pos
                    if v:IsA("BasePart") then pos = v.Position
                    elseif v:IsA("Model") and v.PrimaryPart then pos = v.PrimaryPart.Position
                    elseif v:IsA("Model") then
                        local bp = v:FindFirstChildWhichIsA("BasePart")
                        if bp then pos = bp.Position end
                    end
                    if pos then
                        table.insert(newObjs, {obj=v, pos=pos, name=v.Name, rType=r})
                        count = count + 1
                    end
                end
            end
        end
        worldESPObjects = newObjs
    end
end)

local function getWeaponName(char)
    local tool = char:FindFirstChildWhichIsA("Tool")
    if tool then return tool.Name end
    local rh = char:FindFirstChild("RightHand") or char:FindFirstChild("Right Arm")
    if rh then
        local gm = rh:FindFirstChildOfClass("Model")
        if gm then return gm.Name end
    end
    return nil
end

-- ===== ОСНОВНОЙ ЦИКЛ ESP =====
RunService.RenderStepped:Connect(function()
    local now = tick()
    if now - lastUpdate < ESP_INTERVAL then return end
    lastUpdate = now

    if not Config.ESP_Enabled and not (Config.ESP_Wood or Config.ESP_Stone or Config.ESP_Sulfur or Config.ESP_Metal or Config.ESP_Cloth) then
        return
    end

    pcall(function()
        local draw = {}
        if Config.ESP_Enabled then
            local cnt = 0
            for _, plr in ipairs(Players:GetPlayers()) do
                if cnt >= MAX_HUMAN then break end
                if plr ~= LP and Fust.IsValid(plr.Character) then
                    table.insert(draw, plr.Character); cnt = cnt + 1
                end
            end
            if Config.ESP_Bots then
                for _, b in ipairs(Fust.BotCache or {}) do
                    if cnt >= MAX_HUMAN then break end
                    if Fust.IsValid(b) then table.insert(draw, b); cnt = cnt + 1 end
                end
            end
        end

        local myChar = LP.Character
        local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")

        -- HUMAN ESP
        for _, ch in ipairs(draw) do
            local h = ch:FindFirstChild("Head")
            local r = ch:FindFirstChild("HumanoidRootPart")
            local hu = ch:FindFirstChildOfClass("Humanoid")
            if h and r and hu and hu.Health > 0 then
                local distToMe = myRoot and (r.Position - myRoot.Position).Magnitude or 0
                if distToMe <= Config.ESP_HumanMaxDist then
                    local tp, to = Camera:WorldToViewportPoint(h.Position + Vector3.new(0,0.5,0))
                    local bp, bo = Camera:WorldToViewportPoint(r.Position - Vector3.new(0,2.8,0))
                    if to and bo and tp.Z > 0 then
                        local e = espData[ch]
                        if not e then
                            e = {
                                b = Instance.new("Frame", Gui),
                                n = getLabel(),
                                icon = Instance.new("ImageLabel", Gui),
                                hpTxt = getLabel()
                            }
                            e.b.BackgroundTransparency = 1; e.b.BorderSizePixel = 0
                            Instance.new("UIStroke", e.b).Color = Color3.fromRGB(255,60,60)
                            e.n.TextColor3 = Color3.new(1,1,1)
                            e.icon.BackgroundTransparency = 1
                            e.icon.Size = UDim2.new(0,30,0,30)
                            e.hpTxt.TextColor3 = Color3.fromRGB(0,255,0)
                            e.hpTxt.TextSize = 10
                            espData[ch] = e
                        end

                        local hh = math.abs(bp.Y - tp.Y)
                        e.b.Visible = Config.ESP_Boxes
                        e.b.Position = UDim2.new(0, tp.X - hh*0.3, 0, tp.Y)
                        e.b.Size = UDim2.new(0, hh*0.6, 0, hh)

                        e.n.Visible = Config.ESP_Names
                        e.n.Position = UDim2.new(0, tp.X - 75, 0, tp.Y - 16)
                        e.n.Size = UDim2.new(0,150,0,14)

                        local distStr = myRoot and (" ["..math.floor((r.Position-myRoot.Position).Magnitude).."m]") or ""
                        local weapon = getWeaponName(ch)
                        if weapon then
                            e.n.Text = Config.ESP_WeaponText and (ch.Name.." ["..weapon.."]"..distStr) or (ch.Name..distStr)
                            if Config.ESP_WeaponIcon then
                                e.icon.Visible = true
                                e.icon.Position = UDim2.new(0, tp.X-15, 0, tp.Y-50)
                                e.icon.Image = Icons[weapon] or Icons["Default"]
                            else e.icon.Visible = false end
                        else
                            e.n.Text = ch.Name..distStr
                            e.icon.Visible = false
                        end

                        e.hpTxt.Visible = Config.ESP_HP_Text
                        e.hpTxt.Position = UDim2.new(0, tp.X-15, 1, 2)
                        e.hpTxt.Size = UDim2.new(0,30,0,12)
                        e.hpTxt.Text = tostring(math.floor(hu.Health))
                    else
                        if espData[ch] then
                            espData[ch].b.Visible = false; espData[ch].n.Visible = false
                            espData[ch].icon.Visible = false; espData[ch].hpTxt.Visible = false
                        end
                    end
                else
                    if espData[ch] then
                        espData[ch].b.Visible = false; espData[ch].n.Visible = false
                        espData[ch].icon.Visible = false; espData[ch].hpTxt.Visible = false
                    end
                end
            else
                if espData[ch] then
                    espData[ch].b.Visible = false; espData[ch].n.Visible = false
                    espData[ch].icon.Visible = false; espData[ch].hpTxt.Visible = false
                end
            end
        end

        -- WORLD ESP
        local worldDraw = {}
        local wc = 0
        for _, item in ipairs(worldESPObjects) do
            if wc >= MAX_WORLD then break end
            if item.obj and item.obj.Parent then
                local on = false
                if item.rType == "Wood" and Config.ESP_Wood then on = true end
                if item.rType == "Stone" and Config.ESP_Stone then on = true end
                if item.rType == "Sulfur" and Config.ESP_Sulfur then on = true end
                if item.rType == "Metal" and Config.ESP_Metal then on = true end
                if item.rType == "Cloth" and Config.ESP_Cloth then on = true end
                if on then
                    local dist = myRoot and (item.pos - myRoot.Position).Magnitude or 0
                    if dist <= Config.WorldESP_MaxDist then
                        local sp, vis = Camera:WorldToViewportPoint(item.pos)
                        if vis and sp.Z > 0 then
                            worldDraw[item.obj] = {pos=Vector2.new(sp.X,sp.Y), name=item.name, dist=math.floor(dist)}
                            wc = wc + 1
                        end
                    end
                end
            end
        end

        for obj, d in pairs(worldDraw) do
            local e = espData[obj]
            if not e then
                e = {n = getLabel()}
                e.n.TextColor3 = Color3.fromRGB(255,200,50)
                espData[obj] = e
            end
            e.n.Visible = true
            e.n.Position = UDim2.new(0, d.pos.X-50, 0, d.pos.Y-20)
            e.n.Size = UDim2.new(0,100,0,14)
            e.n.Text = "["..d.name.."] ["..d.dist.."m]"
        end

        -- Очистка
        for obj, e in pairs(espData) do
            if not obj.Parent or (not table.find(draw, obj) and not worldDraw[obj]) then
                if e.b then e.b:Destroy() end
                if e.icon then e.icon:Destroy() end
                if e.n then releaseLabel(e.n) end
                if e.hpTxt then releaseLabel(e.hpTxt) end
                espData[obj] = nil
            end
        end
    end)
end)

print("[Rust Script] Part 5/5 loaded — ESP optimized (Cloth включён)")
