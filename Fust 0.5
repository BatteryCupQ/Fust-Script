    local bt=Instance.new("TextButton",bg)
    bt.Size=UDim2.new(0.5,-5,1,0); bt.Position=UDim2.new(0.5,5,0,0); bt.Text="Torso"; bt.Font=Enum.Font.GothamBold; bt.TextSize=12
    Instance.new("UICorner",bt).CornerRadius=UDim.new(0,6)
    local function up()
        bh.BackgroundColor3=F.Config.Part=="Head" and C.acc or Color3.fromRGB(240,240,240)
        bh.TextColor3=F.Config.Part=="Head" and Color3.new(1,1,1) or C.txt
        bt.BackgroundColor3=F.Config.Part=="Torso" and C.acc or Color3.fromRGB(240,240,240)
        bt.TextColor3=F.Config.Part=="Torso" and Color3.new(1,1,1) or C.txt
    end
    bh.MouseButton1Click:Connect(function() F.Config.Part="Head"; up() end)
    bt.MouseButton1Click:Connect(function() F.Config.Part="Torso"; up() end)
    up()
end

