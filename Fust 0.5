local Pgs,Tbs={},{}
local function SwTab(idx)
    for i,b in ipairs(Tbs) do b.BackgroundTransparency=(i==idx) and 0 or 1; b.TextColor3=(i==idx) and Color3.new(1,1,1) or C.txt end
    for i,p in ipairs(Pgs) do p.Visible=(i==idx) end
end

local function CreateTab(n,idx)
    local b=Instance.new("TextButton",TB)
    b.Size=UDim2.new(1/3,0,1,0); b.Position=UDim2.new((idx-1)/3,0,0,0)
    b.BackgroundColor3=C.acc; b.BackgroundTransparency=1; b.Text=n
    b.TextColor3=C.txt; b.Font=Enum.Font.GothamBold; b.TextSize=12
    local pg=Instance.new("ScrollingFrame",CT2)
    pg.Size=UDim2.new(1,0,1,0); pg.BackgroundTransparency=1; pg.BorderSizePixel=0
    pg.ScrollBarThickness=3; pg.CanvasSize=UDim2.new(0,0,0,500); pg.Visible=false
    table.insert(Tbs,b); table.insert(Pgs,pg)
    b.MouseButton1Click:Connect(function() SwTab(idx) end)
    return pg
end

