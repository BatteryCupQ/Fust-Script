local function AddS(p,txt,k,mn,mx,y)
    local f=Instance.new("Frame",p)
    f.Size=UDim2.new(1,-10,0,45); f.Position=UDim2.new(0,5,0,y); f.BackgroundTransparency=1
    local l=Instance.new("TextLabel",f)
    l.Size=UDim2.new(1,0,0,20); l.BackgroundTransparency=1
    l.Text=txt..": "..F.Config[k]; l.TextColor3=C.txt; l.Font=Enum.Font.Gotham; l.TextSize=12; l.TextXAlignment=Enum.TextXAlignment.Left
    local br=Instance.new("Frame",f)
    br.Size=UDim2.new(1,-10,0,6); br.Position=UDim2.new(0,5,0,25); br.BackgroundColor3=C.trk
    Instance.new("UICorner",br).CornerRadius=UDim.new(1,0)
    local fl=Instance.new("Frame",br)
    fl.Size=UDim2.new((F.Config[k]-mn)/math.max(mx-mn,1),0,1,0); fl.BackgroundColor3=C.acc
    Instance.new("UICorner",fl).CornerRadius=UDim.new(1,0)
    local d=false
    br.InputBegan:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then d=true end end)
    u.InputEnded:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then d=false end end)
    u.InputChanged:Connect(function(i)
        if d then
            local ps=math.clamp((i.Position.X-br.AbsolutePosition.X)/br.AbsoluteSize.X,0,1)
            F.Config[k]=math.floor(mn+(mx-mn)*ps); l.Text=txt..": "..F.Config[k]; fl.Size=UDim2.new(ps,0,1,0)
        end
    end)
end

