local function GetWep(ch)
    local t=ch:FindFirstChildWhichIsA("Tool")
    if t then return t.Name end
    local rh=ch:FindFirstChild("RightHand") or ch:FindFirstChild("Right Arm")
    if rh then local g=rh:FindFirstChildOfClass("Model"); if g then return g.Name end end
    return nil
end

local function IsValid(ch)
    local h=ch and ch:FindFirstChildOfClass("Humanoid")
    if not h or h.Health<=0 or h:GetState()==Enum.HumanoidStateType.Dead or h:GetState()==Enum.HumanoidStateType.Physics then return false end
    local rt=ch:FindFirstChild("HumanoidRootPart")
    if not rt or rt.Anchored then return false end
    return true
end

local function IsVis(pt,ch)
    if not C.Vis then return true end
    local rp=RaycastParams.new()
    rp.FilterDescendantsInstances={lp.Character,ch}; rp.FilterType=Enum.RaycastFilterType.Exclude
    return workspace:Raycast(c.CFrame.Position,pt.Position-c.CFrame.Position,rp)==nil
end

local function GetTgt(fov,dist)
    local best,mD=nil,fov
    local ctr=Vector2.new(c.ViewportSize.X/2,c.ViewportSize.Y/2)
    local mh=lp.Character and lp.Character:FindFirstChild("Head")
    if not mh then return nil end
    
    local function chk(ch)
        if not IsValid(ch) then return end
        local h=ch:FindFirstChild(C.Part)
        if h and (h.Position-mh.Position).Magnitude<=dist then
            local sp,on=c:WorldToViewportPoint(h.Position)
            if on and sp.Z>0 then
                local d2=(Vector2.new(sp.X,sp.Y)-ctr).Magnitude
                if d2<mD and IsVis(h,ch) then mD=d2; best=h end
            end
        end
    end
    
    for _,plr in ipairs(p:GetPlayers()) do if plr~=lp then chk(plr.Character) end end
    if C.AimBot or C.BT then for _,b in ipairs(Bots) do chk(b) end end
    return best
end

task.spawn(function()
    while task.wait(1.5) do
        local nB={}
        if C.Bots or C.AimBot or C.BT then
            for _,v in ipairs(workspace:GetDescendants()) do
                if v:IsA("Model") and IsValid(v) and not p:GetPlayerFromCharacter(v) then
                    table.insert(nB,v)
                end
            end
        end
        Bots=nB
    end
end)

task.spawn(function()
    while task.wait(1) do
        local pc,bc=0,0
        for _,plr in ipairs(p:GetPlayers()) do if plr~=lp and IsValid(plr.Character) then pc=pc+1 end end
        for _,b in ipairs(Bots) do if IsValid(b) then bc=bc+1 end end
        if CT then CT.Text=string.format("Players: %d | Bots: %d",pc,bc) end
    end
end)

workspace.DescendantAdded:Connect(function(inst)
    if not inst:IsA("BasePart") or not C.BT then return end
    local n=inst.Name:lower()
    if n:find("arrow") or n:find("bullet") or n:find("proj") or n:find("bolt") then
        if math.random(1,100)<=C.BTChance then
            local t=GetTgt(500,C.BTRadius)
            if t then
                inst.Gravity=0
                task.spawn(function()
                    while inst.Parent do
                        task.wait(0.03)
                        local h=t.Parent and t.Parent:FindFirstChildOfClass("Humanoid")
                        if h and h.Health>0 then
                            local d=(t.Position-inst.Position).Unit
                            inst.AssemblyLinearVelocity=d*250; inst.CFrame=CFrame.lookAt(inst.Position,inst.Position+d)
                        else break end
                    end
                end)
            end
        end
    end
end)

r.RenderStepped:Connect(function()
    pcall(function()
        NV.Enabled=C.NV
        if C.NV then l.Ambient=Color3.fromRGB(150,150,150); l.OutdoorAmbient=Color3.fromRGB(150,150,150) end
        
        if C.Aim and C.FOVShow then
            FC.Visible=true; FC.Size=UDim2.new(0,C.FOV*2,0,C.FOV*2)
        else FC.Visible=false end
        
        if C.Aim and not C.BT then
            local t=GetTgt(C.FOV,1500)
            if t then c.CFrame=c.CFrame:Lerp(CFrame.lookAt(c.CFrame.Position,t.Position),C.Smooth/10) end
        end
        
        local dr={}
        if C.ESP then
            for _,plr in ipairs(p:GetPlayers()) do
                if plr~=lp and IsValid(plr.Character) then table.insert(dr,plr.Character) end
            end
            if C.Bots then for _,b in ipairs(Bots) do if IsValid(b) then table.insert(dr,b) end end end
        end
        
        local mC=lp.Character; local mR=mC and mC:FindFirstChild("HumanoidRootPart")
        
        for _,ch in ipairs(dr) do
            local h,rt,hu=ch:FindFirstChild("Head"),ch:FindFirstChild("HumanoidRootPart"),ch:FindFirstChildOfClass("Humanoid")
            if h and rt and hu and hu.Health>0 then
                local tp,to=c:WorldToViewportPoint(h.Position+Vector3.new(0,0.5,0))
                local bp,bo=c:WorldToViewportPoint(rt.Position-Vector3.new(0,2.8,0))
                if to and bo and tp.Z>0 then
                    local e=ED[ch]
                    if not e then
                        e={b=Instance.new("Frame",G),n=Instance.new("TextLabel",G),i=Instance.new("ImageLabel",G)}
                        e.b.BackgroundTransparency=1; e.b.BorderSizePixel=0
                        Instance.new("UIStroke",e.b).Color=Color3.fromRGB(255,60,60)
                        e.n.BackgroundTransparency=1; e.n.TextColor3=Color3.new(1,1,1); e.n.Font=Enum.Font.GothamBold; e.n.TextSize=11; e.n.TextStrokeTransparency=0
                        e.i.BackgroundTransparency=1; e.i.Size=UDim2.new(0,30,0,30)
                        ED[ch]=e
                    end
                    local hh=math.abs(bp.Y-tp.Y)
                    e.b.Visible,e.n.Visible=C.Box,C.Name
                    e.b.Position=UDim2.new(0,tp.X-(hh*0.3),0,tp.Y); e.b.Size=UDim2.new(0,hh*0.6,0,hh)
                    
                    local ds=""; if mR then ds=" ["..math.floor((rt.Position-mR.Position).Magnitude).."m]" end
                    e.n.Position=UDim2.new(0,tp.X-75,0,tp.Y-16); e.n.Size=UDim2.new(0,150,0,14)
                    
                    local w=GetWep(ch)
                    if w then
                        e.n.Text=C.WText and (ch.Name.." ["..w.."]"..ds) or (ch.Name..ds)
                        if C.WIcon then e.i.Visible=true; e.i.Position=UDim2.new(0,tp.X-15,0,tp.Y-50); e.i.Image=Icons[w] or Icons.Default else e.i.Visible=false end
                    else
                        e.n.Text=ch.Name..ds; e.i.Visible=false
                    end
                else
                    if ED[ch] then ED[ch].b.Visible=false; ED[ch].n.Visible=false; ED[ch].i.Visible=false end
                end
            else
                if ED[ch] then ED[ch].b.Visible=false; ED[ch].n.Visible=false; ED[ch].i.Visible=false end
            end
        end
        
        for ch,e in pairs(ED) do
            if not ch.Parent or not table.find(dr,ch) then
                e.b:Destroy(); e.n:Destroy(); e.i:Destroy(); ED[ch]=nil
            end
        end
    end)
end)
N("Fust Script","Part 2 Loaded.","#00FF00")
