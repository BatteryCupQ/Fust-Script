    b.Font=Enum.Font.Gotham; b.TextSize=12; b.TextXAlignment=Enum.TextXAlignment.Left
    Instance.new("UICorner",b).CornerRadius=UDim.new(0,6)
    b.MouseButton1Click:Connect(function()
        F.Config[k]=not F.Config[k]
        b.BackgroundColor3=F.Config[k] and C.acc or Color3.fromRGB(240,240,240)
        b.TextColor3=F.Config[k] and Color3.new(1,1,1) or C.txt
